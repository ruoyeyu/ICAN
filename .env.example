# Resource settings / 资源设置 — edit these first.
# Examples only: choose values suitable for your server; 1536m = 1.5 GiB, 2g = 2 GiB.
# 修改后重建容器生效，无须重新编译；保留原数据目录和密钥。
ICAN_CPUS=1.6
ICAN_MEMORY=1536m

# Never commit a real .env. Supply separate random secrets through your operator.
PUBLIC_ORIGIN=https://your-ican.example
ADMIN_USERNAME=
ADMIN_PASSWORD=
JWT_SECRET=
DATA_ENCRYPTION_KEY=
JWT_EXPIRE_HOURS=168
STORAGE_DRIVER=sqlite
# The Docker deployment fixes these paths below /app/data; these settings are for native development.
DATABASE_DSN=/app/data/ican.db
MEDIA_DIR=/app/data/media
AI_LOG_DIR=/app/data/logs
# No hidden defaults: confirm these behavior limits before deployment.
AUTH_ATTEMPTS_PER_MINUTE=
MEDIA_LINK_TTL_SECONDS=
ICAN_IMAGE=
ICAN_HOST_PORT=
ICAN_DATA_DIR=
ICAN_PIDS_LIMIT=
ICAN_TMP_BYTES=
ICAN_CACHE_BYTES=
