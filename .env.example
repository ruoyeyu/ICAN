# Never commit a real .env. Supply separate random secrets through your operator.
PUBLIC_ORIGIN=https://your-ican.example
ADMIN_USERNAME=
ADMIN_PASSWORD=
JWT_SECRET=
DATA_ENCRYPTION_KEY=
JWT_EXPIRE_HOURS=168
STORAGE_DRIVER=sqlite
DATABASE_DSN=/app/data/ican.db
MEDIA_DIR=/app/data/media
AI_LOG_DIR=/app/data/logs
# No hidden defaults: confirm these behavior limits before deployment.
AUTH_ATTEMPTS_PER_MINUTE=
MEDIA_LINK_TTL_SECONDS=
ICAN_HOST_PORT=
ICAN_DATA_DIR=
ICAN_MEMORY_LIMIT=
ICAN_CPU_LIMIT=
ICAN_PIDS_LIMIT=
ICAN_TMP_BYTES=
ICAN_CACHE_BYTES=
